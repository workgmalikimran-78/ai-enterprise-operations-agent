{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(mvn test*)",
      "Bash(mvn -o *)",
      "Bash(mvn compile*)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker inspect*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(curl -X GET http://localhost:*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  }
}
