# Copy this file to .env and fill in real values. docker-compose automatically reads .env for
# ${VAR} substitution - .env itself is gitignored, never commit real keys.

# Which LLM provider the RCA/remediation agents use - "openai" or "anthropic".
AIOPS_LLM_PROVIDER=anthropic

# Only the key matching AIOPS_LLM_PROVIDER needs to be real; the other can stay blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Credentials for the data lake's S3-compatible storage (LocalStack locally - see docker-compose
# .yml's "lake" service). These are local dev defaults, not secrets - change them (and point
# AIOPS_LAKE_ENDPOINT at real object storage) before using this anywhere beyond your own machine.
AIOPS_LAKE_ACCESS_KEY=aiopsminio
AIOPS_LAKE_SECRET_KEY=aiopsminio123

# Optional shared-secret bearer token for the standalone MCP server (mcp-server/). Several of its
# tools execute real cluster mutations (approve/execute remediations, flip the kill switch), and
# the backend itself has no auth yet - leave blank for local dev (no auth on /mcp), set a real
# value before exposing port 8090 beyond your own machine.
MCP_API_KEY=
