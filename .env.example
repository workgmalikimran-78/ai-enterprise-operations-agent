# Copy this file to .env and fill in real values. docker-compose automatically reads .env for
# ${VAR} substitution - .env itself is gitignored, never commit real keys.

# Which LLM provider the RCA/remediation agents use - "openai" or "anthropic".
AIOPS_LLM_PROVIDER=anthropic

# Only the key matching AIOPS_LLM_PROVIDER needs to be real; the other can stay blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
